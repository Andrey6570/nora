rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairPath(pid) { return /databases/$(database)/documents/pairs/$(pid); }
    function isMember(pid) { return signedIn() && me() in get(pairPath(pid)).data.members; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // a partner may change only their own entry in the names map
    function ownNameOnly() {
      return !('names' in changed())
        || request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()]);
    }
    // a game the pair has bought (free games are never listed in pair.games)
    function unlocked(pid, g) { return get(pairPath(pid)).data.get('games', {}).get(g, false) == true; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    // own profile: language, display name, current pair
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['pairId', 'name', 'lang', 'consent', 'createdAt']);
    }

    // invite code -> pair id; readable by anyone signed in who knows the code
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && me() in getAfter(pairPath(request.resource.data.pid)).data.members
        && getAfter(pairPath(request.resource.data.pid)).data.inviteCode == code
        && request.resource.data.keys().hasOnly(['pid']);
      allow update: if false;
      allow delete: if signedIn() && me() in get(pairPath(resource.data.pid)).data.members;
    }

    match /pairs/{pid} {
      allow read: if signedIn() && me() in resource.data.members;

      // stars, the pot and the pet's experience are written only by the server
      allow create: if signedIn()
        && request.resource.data.members == [me()]
        && request.resource.data.keys().hasOnly(['members', 'names', 'inviteCode', 'createdAt', 'scale', 'pet', 'consent'])
        && request.resource.data.names.keys().hasOnly([me()]) && validName(request.resource.data.names[me()]);

      allow update: if signedIn() && ownNameOnly() && (
        // a partner changes settings
        (me() in resource.data.members
          && changed().hasOnly(['names', 'pet', 'scale', 'inviteCode']))
        ||
        // a partner leaves: removes only their own id
        (me() in resource.data.members
          && !(me() in request.resource.data.members)
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && changed().hasOnly(['members']))
        ||
        // the second partner joins with the invite code
        (!(me() in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([me()])
          && request.resource.data.members.size() <= 2
          && request.resource.data.joinProof == resource.data.inviteCode
          && validName(request.resource.data.names[me()])
          && changed().hasOnly(['members', 'names', 'joinProof']))
      );
      allow delete: if false;

      match /tasks/{id} {
        allow read, delete: if isMember(pid);
        allow create, update: if isMember(pid)
          && request.resource.data.keys().hasOnly(['title', 'minutes', 'difficulty', 'repeat', 'full', 'createdBy', 'createdAt', 'archived'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.minutes is int && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 480
          && request.resource.data.difficulty in [1, 2, 3]
          && request.resource.data.repeat in ['once', 'daily', 'weekly']
          && request.resource.data.full is bool;
      }

      // private answers of the games for two: only the author reads them, the server reveals matches in results
      match /answers/{id} {
        allow read: if isMember(pid) && resource.data.uid == me();
        allow create: if isMember(pid)
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'game', 'item', 'v', 'g', 'at'])
          && request.resource.data.game in ['guess', 'wishes']
          && request.resource.data.item is string && request.resource.data.item.size() <= 2
          && id == request.resource.data.game + '_' + request.resource.data.item + '_' + me()
          && (request.resource.data.game == 'guess' || unlocked(pid, request.resource.data.game));
        allow update, delete: if false;
      }
      match /results/{id} {
        allow read: if isMember(pid);
        allow write: if false;
      }

      // gift coupons: the author gives, the partner marks one as used
      match /coupons/{id} {
        allow read: if isMember(pid);
        allow create: if isMember(pid) && unlocked(pid, 'coupons')
          && request.resource.data.from == me()
          && request.resource.data.keys().hasOnly(['from', 'title', 'at'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80;
        allow update: if isMember(pid) && resource.data.from != me() && !('used' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
          && request.resource.data.used == true;
        allow delete: if isMember(pid) && resource.data.from == me() && !('used' in resource.data);
      }

      // progress of the 30 days of closeness
      match /progress/{game} {
        allow read: if isMember(pid);
        allow create, update: if isMember(pid) && game == 'intimacy30' && unlocked(pid, game)
          && request.resource.data.keys().hasOnly(['start', 'done'])
          && request.resource.data.start is string && request.resource.data.start.size() == 10
          && request.resource.data.done is list && request.resource.data.done.size() <= 30;
        allow delete: if false;
      }

      // rewards the pair chose: scope "personal" is bought from one's own stars, "joint" from the pot together
      match /rewards/{id} {
        allow read, delete: if isMember(pid);
        allow create, update: if isMember(pid)
          && request.resource.data.keys().hasOnly(['title', 'cost', 'scope', 'createdBy', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
          && request.resource.data.cost is int && request.resource.data.cost >= 1 && request.resource.data.cost <= 9999
          && request.resource.data.scope in ['personal', 'joint'];
      }

      // purchases: the app asks, the server prices, charges and sets the status
      match /orders/{id} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'ref', 'at'])
          && request.resource.data.kind in ['reward', 'game']
          && request.resource.data.ref is string && request.resource.data.ref.size() <= 40;
        // the partner agrees to a proposal; either partner marks a bought reward as used
        allow update: if isMember(pid) && (
          (resource.data.status == 'proposed' && resource.data.uid != me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy'])
            && request.resource.data.approvedBy == me())
          ||
          (resource.data.status == 'bought' && resource.data.kind == 'reward'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
            && request.resource.data.used == true));
        // a proposal can be withdrawn by its author or declined by the partner
        allow delete: if isMember(pid) && resource.data.status == 'proposed';
      }

      // reactions and warm signals: the server checks them, applies the daily limit and sends the push
      match /signals/{id} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.from == me()
          && request.resource.data.keys().hasOnly(['from', 'kind', 'key', 'ref', 'day', 'at'])
          && request.resource.data.kind in ['message', 'reaction']
          && request.resource.data.key is string && request.resource.data.key.size() <= 30
          && request.resource.data.day is string
          && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() <= 120));
        allow update, delete: if false;
      }

      // this phone's push token, so the other partner's actions can reach it
      match /devices/{id} {
        allow read: if false;
        allow create, update: if isMember(pid)
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'token', 'lang', 'at'])
          && request.resource.data.token is string && request.resource.data.lang in ['ru', 'en', 'el'];
        allow delete: if isMember(pid) && resource.data.uid == me();
      }

      // a mark that a stage is done; the id names the task, stage and period, so each is claimed once
      match /log/{id} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'day', 'at', 'once', 'together'])
          && request.resource.data.day is string
          && (!('together' in request.resource.data) || request.resource.data.together == true);
        allow update: if false;
        allow delete: if isMember(pid) && resource.data.uid == me();
      }
    }
  }
}
